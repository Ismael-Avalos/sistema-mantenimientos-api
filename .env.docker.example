# Copia este archivo como .env.docker y sustituye los valores de ejemplo.
# Si PostgreSQL esta en otro servidor, usa su direccion en lugar de host.docker.internal.
DB_URL=jdbc:postgresql://host.docker.internal:5432/nombre_de_tu_base
DB_USERAPI=tu_usuario
DB_PASSWORDAPI=tu_contrasena
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
